"qwe\stm32f1xx_hal.o"
"qwe\stm32f1xx_hal_rcc.o"
"qwe\stm32f1xx_hal_rcc_ex.o"
"qwe\stm32f1xx_hal_gpio.o"
"qwe\stm32f1xx_hal_dma.o"
"qwe\stm32f1xx_hal_cortex.o"
